{
  "name": "sideline",
  "version": "0.1.0",
  "description": "Extract code comments into a YAML store, keeping code and comment data separate. Reversible and idempotent.",
  "type": "module",
  "bin": {
    "sideline": "dist/cli.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
